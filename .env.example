# JSON Web Token secret for authentication signing
JWT_SECRET=your-super-secret-jwt-signing-key

# OpenAI configuration for weekly cognitive report generation
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Client API URL (Optional, defaults to Nginx reverse proxy http://localhost)
VITE_API_URL=http://localhost
